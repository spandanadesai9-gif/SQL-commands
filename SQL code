CREATE TABLE RideBooking (
    booking_id INT PRIMARY KEY AUTO_INCREMENT,
    passenger_name VARCHAR(50),
    pickup_location VARCHAR(100),
    destination VARCHAR(100),
    distance_km DOUBLE,
    ride_type VARCHAR(20),
    rate_per_km DOUBLE,
    fare DOUBLE
);
